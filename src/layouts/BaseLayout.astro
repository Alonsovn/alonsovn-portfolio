---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/dm-sans/wght-italic.css';
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import '@/styles/globals.css';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(site.ogImage, site.url).href;
const sameAs = [...Object.values(site.socials), site.ossProfile];
const personId = `${site.url}/#person`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: site.fullName,
    alternateName: site.name,
    worksFor: { '@type': 'Organization', name: site.employer },
    url: site.url,
    description,
    image: ogImageUrl,
    jobTitle: site.jobTitle,
    address: { '@type': 'PostalAddress', addressCountry: site.countryCode },
    sameAs,
    knowsAbout: site.knowsAbout,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${site.name} — Portfolio`,
    url: site.url,
    inLanguage: 'en',
    publisher: { '@id': personId },
    author: { '@id': personId },
  },
];

// Runs before first paint so the saved theme never flashes; `js` gates scroll-reveal hiding
// and is dropped again if the reveal script never loads, so content cannot stay hidden.
const themeBootstrap = `(function(){
  var root = document.documentElement;
  root.classList.add('js');
  try {
    var saved = localStorage.getItem('portfolio-theme');
    var mode = saved === 'light' || saved === 'dark'
      ? saved
      : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    root.dataset.theme = mode;
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', mode === 'dark' ? '${site.themeColor.dark}' : '${site.themeColor.light}');
  } catch (error) {}
  setTimeout(function () {
    if (root.dataset.reveal !== 'ready') root.classList.remove('js');
  }, 4000);
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={site.themeColor.light} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeBootstrap} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName} — ${site.jobTitle}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
