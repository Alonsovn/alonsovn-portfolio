---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ScrollToTop from '@/components/layout/ScrollToTop.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Skills from '@/components/sections/Skills.astro';
import Projects from '@/components/sections/Projects.astro';
import Organizations from '@/components/sections/Organizations.astro';
import Timeline from '@/components/sections/Timeline.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <About />
    <Skills />
    <Projects />
    <Organizations />
    <Timeline />
    <Contact />
  </main>
  <Footer />
  <ScrollToTop />
</BaseLayout>

<script>
  import '@/scripts/theme';
  import '@/scripts/scroll-spy';
  import '@/scripts/mobile-menu';
  import '@/scripts/filters';
  import '@/scripts/scroll-top';
  import '@/scripts/reveal';
</script>
