---
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { sectionIds } from '@/lib/sections';
---

<section id={sectionIds.contact} class="contact">
  <h2 class="section-title title reveal">Let's Connect</h2>

  <p class="subtitle reveal" style="--reveal-index: 1">
    I'm always open to interesting conversations, collaboration opportunities, and technical mentorship.
  </p>

  <div class="availability reveal" style="--reveal-index: 2">
    <span class="availabilityDot"></span>
    <strong>Available for freelance &amp; opportunities</strong>
  </div>

  <div class="reveal" style="--reveal-index: 3">
    <div class="card content">
      <p class="email">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="phone text-secondary">
        <Icon name="phone" size={14} />
        <a class="phoneLink" href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a>
      </p>

      <div class="actions">
        <a class="btn btn--primary btn--lg" href={`mailto:${site.email}`}>
          <Icon name="mail" />
          Send Email
        </a>
        <a class="btn btn--default btn--lg" href="/resume.pdf" target="_blank" download>
          <Icon name="file-text" />
          Download Resume
        </a>
      </div>

      <p class="divider text-secondary"><span>Or find me on</span></p>

      <div class="actions">
        <a class="btn btn--default" href={site.socials.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          GitHub
        </a>
        <a class="btn btn--default" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" />
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  <p class="footerNote reveal" style="--reveal-index: 4">
    For freelance inquiries, reach out through
    <a href={site.organizations.naranjoSolutions} target="_blank" rel="noopener noreferrer">NaranjoSolutions</a>
  </p>
</section>

<style>
  .contact {
    max-width: 700px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .title {
    margin-bottom: 1rem;
  }

  .subtitle {
    margin-bottom: 3rem;
    font-size: 1rem;
    text-align: center;
    opacity: 0.7;
  }

  .availability {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    border-radius: 12px;
    background: rgba(82, 196, 26, 0.08);
    color: color-mix(in srgb, var(--color-success) 55%, var(--color-text));
  }

  .availabilityDot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-success);
    animation: pulse 2s infinite;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .email {
    font-size: 1.1rem;
    font-weight: 600;
    text-align: center;
  }

  .phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .phoneLink {
    color: inherit;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--color-border);
  }

  .footerNote {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .footerNote a {
    text-decoration: underline;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.3);
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding: 4rem 1rem;
    }
  }
</style>
